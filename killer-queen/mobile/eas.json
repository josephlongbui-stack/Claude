{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_KQ_URL": "http://localhost:3000" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_KQ_URL": "https://killer-queen.fly.dev" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_PUBLIC_KQ_URL": "https://killer-queen.fly.dev" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID", "appleTeamId": "REPLACE_WITH_TEAM_ID" },
      "android": { "track": "internal", "serviceAccountKeyPath": "./play-service-account.json" }
    }
  }
}

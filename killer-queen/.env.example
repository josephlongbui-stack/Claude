# Killer Queen configuration (see docs/PRODUCT_SPEC.md "Configuration")
KQ_MODE=sandbox                 # live turns off play money, open sign-up and the simulated runner
RUNNER=simulated                # external waits for signed results from the runner service
RUNNER_SECRET=                  # shared secret for runner auth and HMAC signatures (required for the runner routes)
DB_PATH=data/killer-queen.db    # SQLite journal file
STARTING_CASH_CENTS=100000      # play money for new traders ($1,000)
HOUSE_BOTS=mm,sim,llm           # market maker, heuristic traders, LLM traders
ANTHROPIC_API_KEY=              # turn on that lab's LLM trader
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=                # current model id from each provider's docs
OPENAI_MODEL=
GEMINI_MODEL=
ADMIN_KEY=                      # lets an admin settle a task by hand in the sandbox
PORT=3000
TRADING_WINDOW_MS=600000        # default trading window (10 minutes)
BOT_TICK_MS=2000                # scheduler and bot loop interval
SIMULATED_RUNNER_DELAY_MS=1500  # how long the simulated runner "runs" before settling
MM_CASH_CENTS=100000000         # house market maker bankroll
SIM_TRADERS=3                   # number of heuristic house traders
LOG_LEVEL=info                  # silent | info | debug
RATE_LIMIT_ORDERS_PER_MIN=30    # per API key; 0 disables (429 rate_limited)
RATE_LIMIT_TASKS_PER_MIN=5
RATE_LIMIT_WRITES_PER_MIN=60    # cancels, comments, faucet, close, decide
RATE_LIMIT_READS_PER_MIN=120    # authenticated reads (me, portfolio, agent markets)
RATE_LIMIT_ANON_PER_MIN=300     # per IP for public reads and sign-up
BASELINE_CHECK=true             # D2: a task's markets open only after 3 agent-free test runs all fail
